{
	"name": "nes-cart-browser",
	"version": "0.0.3",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=24.11.0 <25",
		"bun": "1.4.4"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview --port 5173",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check && eslint .",
		"format": "vp fmt",
		"test": "bun run test:unit && bun run test:e2e",
		"test:e2e": "playwright test",
		"test:unit": "vp test run",
		"precommit": "bun run format && bun run lint && bun run check && bun run build && bun run test",
		"scrape": "tsx ./scraper/scraper.ts"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.72.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "24.19.2",
		"@unpic/svelte": "^1.0.1",
		"@vitest/browser-playwright": "5.1.0",
		"bits-ui": "2.21.0",
		"clsx": "^2.1.1",
		"eslint": "10.14.0",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"playwright": "1.65.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "4.0.2",
		"tailwindcss": "4.3.5",
		"tsx": "4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "3.1.0",
		"vite-plus": "1.6.0"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"mode-watcher": "^1.1.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vitest": "5.1.0"
	}
}
