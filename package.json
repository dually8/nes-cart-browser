{
	"name": "nes-cart-browser",
	"version": "0.0.3",
	"private": true,
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24.0.0 <25",
		"pnpm": "12.14.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --port 5173",
		"prepare": "svelte-kit sync || echo ''",
		"test": "pnpm run test:e2e && pnpm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"precommit": "pnpm run format && pnpm run lint && pnpm run check && pnpm run build && pnpm run test",
		"scrape": "tsx ./scraper/scraper.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"@unpic/svelte": "^1.0.1",
		"@vitest/browser-playwright": "4.1.12",
		"bits-ui": "^2.15.5",
		"clsx": "^2.1.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"playwright": "1.64.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.5.9",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwind-merge": "^3.4.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.55.0",
		"vite": "7.3.7",
		"vitest": "4.1.12",
		"vitest-browser-svelte": "^2.0.2"
	},
	"type": "module",
	"dependencies": {
		"mode-watcher": "^1.1.0"
	}
}
