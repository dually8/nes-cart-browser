{
	"name": "nes-cart-browser",
	"version": "0.0.3",
	"private": true,
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24.0.0 <25",
		"pnpm": "12.14.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --port 5173",
		"prepare": "svelte-kit sync || echo ''",
		"test": "pnpm run test:e2e && pnpm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"precommit": "pnpm run format && pnpm run lint && pnpm run check && pnpm run build && pnpm run test",
		"scrape": "tsx ./scraper/scraper.ts"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.60.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"@unpic/svelte": "^1.0.1",
		"@vitest/browser-playwright": "5.0.5",
		"bits-ui": "2.20.0",
		"clsx": "^2.1.1",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.4",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"mode-watcher": "^1.1.0"
	}
}
